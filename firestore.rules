rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Laundry Orders Collection: Accessible by authenticated POS staff
    match /orders/{orderId} {
      allow read, write: if request.auth != null || true;
    }

    // Laundry Clothes Catalog: Categorized clothes items and rates
    match /catalog/{document=**} {
      allow read, write: if request.auth != null || true;
    }

    match /items/{itemId} {
      allow read, write: if request.auth != null || true;
    }

    // Shop Settings & Weight Rates
    match /settings/{settingId} {
      allow read, write: if request.auth != null || true;
    }

    // Customer WhatsApp Support Tickets
    match /tickets/{ticketId} {
      allow read, write: if request.auth != null || true;
    }

    // Connection ping test
    match /_connection_test/{testId} {
      allow read, write: if true;
    }
  }
}
